{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm fmt)",
      "Bash(pnpm bindings)",
      "Bash(pnpm --filter @teitunnel/desktop test *)",
      "Bash(pnpm --filter @teitunnel/desktop typecheck)",
      "Bash(pnpm --filter @teitunnel/web test)",
      "Bash(pnpm --filter @teitunnel/web typecheck)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest run *)",
      "Bash(node scripts/ci/check-agent-docs.mjs)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key.asc)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Bash(security dump-keychain *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
