{
  "manifest_version": 3,
  "name": "Teitunnel",
  "short_name": "Teitunnel",
  "version": "0.1.0",
  "description": "Share the local page you're on at a public URL, and see your shares, with the Teitunnel app.",
  "homepage_url": "https://teitunnel.teispace.com/docs/guides/browser-extension",
  "permissions": ["nativeMessaging", "activeTab"],
  "action": {
    "default_title": "Teitunnel",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "116",
  "key": ""
}
