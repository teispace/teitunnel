{
  "name": "teitunnel",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @teitunnel/desktop tauri dev",
    "build": "pnpm --filter @teitunnel/desktop tauri build",
    "tauri": "pnpm --filter @teitunnel/desktop tauri",
    "check": "biome ci . && node scripts/release/check-versions.mjs && pnpm --filter @teitunnel/desktop typecheck && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test": "pnpm --filter @teitunnel/desktop test && cargo nextest run --workspace --locked",
    "fmt": "biome check --write . && cargo fmt --all",
    "bindings": "cargo run --quiet --locked -p teitunnel-desktop --features bindings --bin export-bindings",
    "prepare": "lefthook install",
    "verify": "pnpm check && pnpm test && cargo deny check --hide-inclusion-graph"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "lefthook": "2.1.14"
  }
}
