---
source: crates/core/src/export.rs
expression: file.contents
---
# Tunnel "MacBook-Pro" and its routes, exported by Teitunnel for the Cloudflare
# Terraform provider v5. The import blocks adopt what already exists, so
# `terraform plan` shows no changes; nothing is recreated.
# Needs an API token with Cloudflare Tunnel: Edit and DNS: Edit.
# Terraform takes over these resources: change them there, not in Teitunnel.

terraform {
  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5"
    }
  }
}

locals {
  account_id = "023e105f4ecef8ad9ca31a8372d0c353"
}

resource "cloudflare_zero_trust_tunnel_cloudflared" "mac" {
  account_id = local.account_id
  name       = "MacBook-Pro"
  config_src = "cloudflare"
}

import {
  to = cloudflare_zero_trust_tunnel_cloudflared.mac
  id = "023e105f4ecef8ad9ca31a8372d0c353/6ff42ae2-765d-4adf-8112-31c55c1551ef"
}

resource "cloudflare_zero_trust_tunnel_cloudflared_config" "mac" {
  account_id = local.account_id
  tunnel_id  = cloudflare_zero_trust_tunnel_cloudflared.mac.id
  config = {
    ingress = [
      {
        hostname = "app.xyz.com"
        service  = "http://localhost:3000"
      },
      {
        hostname       = "api.xyz.com"
        path           = "^/v1/"
        service        = "http://localhost:8000"
        origin_request = {
          connect_timeout   = 10
          http_host_header  = "api.local"
          match_sn_ito_host = false
          no_tls_verify     = true
        }
      },
      {
        service = "http_status:404"
      },
    ]
  }
}

import {
  to = cloudflare_zero_trust_tunnel_cloudflared_config.mac
  id = "023e105f4ecef8ad9ca31a8372d0c353/6ff42ae2-765d-4adf-8112-31c55c1551ef"
}

resource "cloudflare_dns_record" "app_xyz_com" {
  zone_id = "z1"
  name    = "app.xyz.com"
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.mac.id}.cfargotunnel.com"
  proxied = true
  ttl     = 1
  comment = "teitunnel:route=a1"
}

import {
  to = cloudflare_dns_record.app_xyz_com
  id = "z1/r1"
}

resource "cloudflare_dns_record" "api_xyz_com" {
  zone_id = "z1"
  name    = "api.xyz.com"
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.mac.id}.cfargotunnel.com"
  proxied = true
  ttl     = 300
}

import {
  to = cloudflare_dns_record.api_xyz_com
  id = "z1/r2"
}
